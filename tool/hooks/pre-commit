#!/bin/sh
# When pubspec.lock is staged, re-resolve Swift Package Manager dependencies for
# each Apple platform so Package.resolved drift fails at commit time instead of
# showing up as an unexpected diff after the next build.
# Enable once per clone: git config core.hooksPath tool/hooks

git diff --cached --name-only | grep -qx 'pubspec.lock' || exit 0

root=$(git rev-parse --show-toplevel)
cd "$root" || exit 1

# Regenerates FlutterGeneratedPluginSwiftPackage, which the Xcode projects depend on.
flutter pub get >/dev/null || { echo "pre-commit: flutter pub get failed"; exit 1; }

for platform in ios macos; do
  resolved="$platform/Runner.xcworkspace/xcshareddata/swiftpm/Package.resolved"
  [ -f "$resolved" ] || continue
  echo "pre-commit: resolving Swift packages in $platform/"
  if ! out=$(xcodebuild -resolvePackageDependencies -workspace "$platform/Runner.xcworkspace" -scheme Runner 2>&1); then
    echo "$out" | tail -20
    echo "pre-commit: Swift package resolution failed in $platform/. Try: flutter build $platform --debug"
    exit 1
  fi
  if ! git diff --quiet -- "$platform"/Runner.xcworkspace/xcshareddata/swiftpm "$platform"/Runner.xcodeproj/project.xcworkspace/xcshareddata/swiftpm; then
    echo "pre-commit: $resolved changed after resolving packages. Review and stage it."
    exit 1
  fi
done
